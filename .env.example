# 环境变量配置示例
# 复制此文件为 .env 并填写实际值

# Google Vertex AI API Key
VERTEX_API_KEY=your_api_key_here

# 火山引擎 ARK (豆包) API Key
ARK_API_KEY=your_ark_api_key_here

# 阿里云 DashScope API Key (用于视频生成)
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# 盛算云 API Key (用于视频和图片生成)
SHENGSUANYUN_API_KEY=your_shengsuanyun_api_key_here

# 视频生成服务类型: "jimeng" (即梦首尾帧) 或 "wan22" (阿里wan2.2首尾帧) 或 "doubao" (豆包-seedance-1.0-pro)
VIDEO_SERVICE_TYPE=jimeng

# 阿里云 OSS 配置 (用于上传图片供 DashScope 访问)
OSS_ACCESS_KEY=your_oss_access_key
OSS_SECRET_KEY=your_oss_secret_key
OSS_ENDPOINT=http://oss-cn-guangzhou.aliyuncs.com
OSS_REGION=cn-guangzhou
OSS_BUCKET=your_bucket_name
